# HRZ portfolio backend configuration — ONE file for everything.
# Copy to ".env" (same folder) and fill in the two keys. Never commit .env.

# ---- Gemini (résumé chatbot) — https://aistudio.google.com/apikey
GEMINI_API_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ---- Resend (contact form email) — https://resend.com/api-keys
RESEND_API_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
CONTACT_RECIPIENT_EMAIL=muhammadhamzaalam2@gmail.com
# Resend's shared test sender works ONLY when the recipient is the email you signed up to Resend with.
# After verifying your own domain in Resend, change this to e.g. "HRZ Portfolio <contact@yourdomain.com>".
EMAIL_FROM_ADDRESS=HRZ Portfolio <onboarding@resend.dev>

# ---- Optional
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# RESUME_PDF_PATH=backend/data/resume.pdf
# RAG_INCLUDE_PHONE=0          # 1 = let the chatbot share the phone number from the résumé
# TRUST_PROXY=0                # 1 when deployed behind a reverse proxy (uses X-Forwarded-For for rate limits)
