"""Settings loaded from the single project-root .env file (hrz-city/.env)."""
from __future__ import annotations

import os
from dataclasses import dataclass, field
from pathlib import Path

from dotenv import load_dotenv

BACKEND_DIR = Path(__file__).resolve().parents[1]
PROJECT_DIR = BACKEND_DIR.parent
load_dotenv(PROJECT_DIR / ".env", override=False)


def _env(name: str, default: str = "", *aliases: str) -> str:
    for key in (name, *aliases):
        value = os.getenv(key, "").strip()
        if value:
            return value
    return default


def _path(value: str) -> Path:
    p = Path(value)
    return p if p.is_absolute() else PROJECT_DIR / p


@dataclass(frozen=True)
class Settings:
    # Gemini
    gemini_api_key: str = field(default_factory=lambda: _env("GEMINI_API_KEY"))
    chat_model: str = field(default_factory=lambda: _env("GEMINI_CHAT_MODEL", "gemini-3.1-flash-lite"))
    embedding_model: str = field(default_factory=lambda: _env("GEMINI_EMBEDDING_MODEL", "gemini-embedding-2"))
    embedding_dim: int = field(default_factory=lambda: int(_env("GEMINI_EMBEDDING_DIM", "768")))
    # Email (Resend)
    resend_api_key: str = field(default_factory=lambda: _env("RESEND_API_KEY", "", "EMAIL_PROVIDER_API_KEY"))
    recipient: str = field(default_factory=lambda: _env("CONTACT_RECIPIENT_EMAIL", "muhammadhamzaalam2@gmail.com"))
    from_address: str = field(default_factory=lambda: _env("EMAIL_FROM_ADDRESS", "HRZ Portfolio <onboarding@resend.dev>"))
    # RAG
    resume_pdf: Path = field(default_factory=lambda: _path(_env("RESUME_PDF_PATH", "backend/data/resume.pdf")))
    index_path: Path = field(default_factory=lambda: _path(_env("RAG_INDEX_PATH", "backend/data/resume_index.json")))
    top_k: int = field(default_factory=lambda: int(_env("RAG_TOP_K", "5")))
    # Web
    allowed_origins: list[str] = field(
        default_factory=lambda: [o.strip() for o in _env(
            "ALLOWED_ORIGINS", "http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"
        ).split(",") if o.strip()]
    )
    frontend_dist: Path = field(default_factory=lambda: PROJECT_DIR / "dist")

    @property
    def gemini_configured(self) -> bool:
        return bool(self.gemini_api_key)

    @property
    def email_configured(self) -> bool:
        return bool(self.resend_api_key and self.from_address and self.recipient)


def get_settings() -> Settings:
    return Settings()
